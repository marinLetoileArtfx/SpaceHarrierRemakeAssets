            {
                def Shader "UsdPreviewSurfaceShader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    float3 inputs:diffuseColor.connect = </RootNode/material/skin/UsdPreviewSurface/diffuseColorTextureShader.outputs:rgb>
